{
  "name": "dsh-pterodactyl",
  "version": "0.1.6",
  "description": "Pterodactyl 面板 Agent 工具：服务器状态、电源、备份、文件与 WebSocket 控制台。",
  "type": "module",
  "license": "MIT",
  "author": "mykodb",
  "homepage": "https://github.com/mykodb/dsh-pterodactyl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mykodb/dsh-pterodactyl.git"
  },
  "bugs": {
    "url": "https://github.com/mykodb/dsh-pterodactyl/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "pterodactyl",
    "minecraft",
    "panel",
    "agent"
  ],
  "exports": {
    ".": "./entry.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "entry.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  }
}
